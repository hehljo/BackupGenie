# BackupGenie Configuration
# Copy this file to .env and adjust values

# Server Configuration
FLASK_ENV=production
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY
DEBUG=false

# API Configuration
API_PORT=5000
API_HOST=0.0.0.0

# Frontend Configuration
FRONTEND_PORT=3000

# Backup Configuration
BACKUP_BASE_PATH=/mnt/backup
MAX_PARALLEL_TASKS=auto
LOG_RETENTION_DAYS=30

# Data Paths (für persistente Daten, z.B. Synology: /volume1/docker/backupgenie/...)
# CONFIG_PATH=./config
# DATA_PATH=./data
# LOGS_PATH=./logs

# Database (SQLite by default)
DATABASE_URL=sqlite:////data/backupgenie.db

# Platform Configuration
# auto = detect hardware automatically at container start
# Options: auto, raspberrypi, synology, server
PLATFORM_PROFILE=auto

# Resource Limits (adjust for your hardware)
BACKEND_CPU_LIMIT=2.0
BACKEND_MEMORY_LIMIT=1G
FRONTEND_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=256M

# Credentials (set these in a separate .env.secrets file)
# NAS_PASSWORD_1=your_nas_password
# GITHUB_TOKEN=ghp_your_github_token
# RCLONE_CONFIG_GDRIVE_TOKEN=your_gdrive_token

# Supabase
# SUPABASE_DB_PASSWORD=your_database_password
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Backup Scheduler ---
# Timezone for scheduled backups. "03:00" means 03:00 local wall clock.
TZ=Europe/Berlin
# Set to false to disable time-based scheduling entirely
SCHEDULER_ENABLED=true
