    {
      "id": "nextcloud",
      "name": "Nextcloud via WebDAV",
      "type": "webdav",
      "enabled": true,
      "priority": 21,
      "host": "cloud.example.com",
      "path": "/remote.php/dav/files/username/Backup",
      "https": true,
      "vendor": "nextcloud",
      "credentials": {
        "username_env": "NEXTCLOUD_USER",
        "password_env": "NEXTCLOUD_PASSWORD"
      },
      "options": {
        "method": "rclone",
        "transfers": 4,
        "delete": false
      }
    },
    {
      "id": "ftp-server",
      "name": "FTP Server",
      "type": "ftp",
      "enabled": true,
      "priority": 22,
      "host": "ftp.example.com",
      "port": 21,
      "path": "/backup",
      "ftps": false,
      "credentials": {
        "username_env": "FTP_USER",
        "password_env": "FTP_PASSWORD"
      },
      "options": {
        "parallel": 2,
        "delete": false,
        "only_newer": true
      }
    },
    {
      "id": "sftp-server",
